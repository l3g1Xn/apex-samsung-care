<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Apex Care is offline-first; block cleartext and keep defaults tight. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
